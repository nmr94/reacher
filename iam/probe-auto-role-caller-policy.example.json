{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TemporaryNetworkProbes",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:InvokeFunction",
        "lambda:DeleteFunction"
      ],
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:aws-network-asserts-*"
    },
    {
      "Sid": "TemporaryProbeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/aws-network-asserts-*"
    },
    {
      "Sid": "PassTemporaryProbeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/aws-network-asserts-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "VpcValidationAndEniCleanupReads",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:GetSecurityGroupsForVpc",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
