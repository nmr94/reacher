{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedProbeSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/aws-network-asserts:probe": "aws-network-asserts-*"
        }
      }
    },
    {
      "Sid": "CreateProbeGroupInSelectedVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:REGION:*:vpc/VPC_ID"
    },
    {
      "Sid": "TagProbeGroupDuringCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSecurityGroup"
        }
      }
    },
    {
      "Sid": "DeleteTaggedProbeGroups",
      "Effect": "Allow",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/aws-network-asserts:probe": "aws-network-asserts-*"
        }
      }
    },
    {
      "Sid": "DiscoverSubnetVpcAndConfirmGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*"
    }
  ]
}
